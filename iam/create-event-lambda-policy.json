{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteEventsFile",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::__BUCKET_NAME__/events.json"
    },
    {
      "Sid": "ListBucketSoMissingFileReturns404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET_NAME__"
    },
    {
      "Sid": "PublishEventNotifications",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "__TOPIC_ARN__"
    }
  ]
}
